---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}
const { title, description, date, tags } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — Arsalan Ghogari`} description={description} type="article">
  <article class="post">
    <div class="wrap">
      <a class="back" href="/writing">← Writing</a>
      <header class="post-head">
        <h1 class="display post-title">{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{dateStr}</time>
          {tags.length > 0 && (
            <span class="tags">{tags.map((t) => <span class="tag-chip">{t}</span>)}</span>
          )}
        </div>
      </header>
      <div class="prose post-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding: clamp(48px, 8vh, 96px) 0; }
  .wrap { max-width: var(--maxw-prose); }
  .back {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .post-head { margin: 22px 0 36px; }
  .post-title { font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.02em; }
  .post-meta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag-chip {
    border: 1px solid var(--line);
    padding: 2px 8px;
    background: var(--panel);
    text-transform: lowercase;
  }

  .post-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin: 36px 0 12px;
  }
  .post-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    margin: 28px 0 10px;
  }
  .post-body :global(p) { margin: 0 0 18px; }
  .post-body :global(ul),
  .post-body :global(ol) { margin: 0 0 18px; padding-left: 22px; }
  .post-body :global(li) { margin-bottom: 8px; }
  .post-body :global(a) { color: var(--accent); }
  .post-body :global(blockquote) {
    margin: 0 0 22px;
    padding: 12px 18px;
    border-left: 3px solid var(--accent);
    background: var(--accent-wash);
    color: var(--ink-soft);
    font-style: italic;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--panel-2);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .post-body :global(strong) { color: var(--ink); }
</style>
