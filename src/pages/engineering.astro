---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { PROJECTS } from '../data/projects';
import { STACK } from '../data/experience';

const disciplines = [
  { name: 'Machine Learning', detail: 'YOLO / RT-DETR training, datasets, evaluation' },
  { name: 'Computer Vision', detail: 'Underwater perception, OpenCV, detection pipelines' },
  { name: 'Robotics', detail: 'ROS, SLAM integration, mission logic' },
  { name: 'Full Stack', detail: 'React + TypeScript, web platforms at scale' },
  { name: 'Embedded', detail: 'ESP32, Jetson Xavier, Raspberry Pi' },
  { name: 'Leadership', detail: 'Leading teams, mentoring, cross-org coordination' },
];
---

<BaseLayout
  title="Engineering — Arsalan Ghogari"
  description="Case studies in machine learning, computer vision, robotics, and full-stack engineering."
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Engineering</span>
      <h1 class="display page-title">The engineering story behind each project.</h1>
      <p class="prose lede">
        I work across machine learning, computer vision, robotics, and full-stack — usually where
        a research-y idea has to turn into something people actually use.
      </p>
    </div>
  </section>

  <!-- DISCIPLINES -->
  <section class="bordered-top">
    <div class="wrap">
      <div class="disciplines">
        {disciplines.map((d) => (
          <div class="disc io-reveal">
            <div class="disc-name">{d.name}</div>
            <div class="disc-detail">{d.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="bordered-top">
    <div class="wrap">
      <span class="eyebrow">Case studies</span>
      <div class="cases">
        {PROJECTS.map((p) => <CaseStudy project={p} />)}
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="bordered-top">
    <div class="wrap">
      <div class="row">
        <h2 class="section-h">Stack</h2>
        <div class="skills">
          {STACK.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: clamp(56px, 9vh, 110px) 0 clamp(30px, 5vh, 56px); }
  .page-title {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    max-width: 18ch;
    margin: 18px 0 0;
  }
  .lede { margin: 24px 0 0; font-size: clamp(1.1rem, 1vw + 1rem, 1.4rem); color: var(--ink-soft); }

  .disciplines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .disc { background: var(--paper); padding: 22px; }
  .disc-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .disc-detail { margin-top: 6px; color: var(--ink-soft); font-size: 0.95rem; }

  .cases { margin-top: 8px; }
</style>
