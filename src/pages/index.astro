---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleCard from '../components/RoleCard.astro';
import { SITE, SOCIAL } from '../consts';
import {
  CURRENT_ROLES, PAST_ROLES, VOLUNTEERING, TECHNICAL_PROJECTS, NON_TECHNICAL,
  TECH_SKILLS, EDUCATION,
} from '../data/content';
---

<BaseLayout person={true}>
  <!-- 01 · TITLE -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="status reveal">
        <span class="dot"></span> available for internships
        <span class="sep">·</span> Los Angeles
        <span class="sep">·</span> <span class="mono-dim">press <span class="kbd">⌘K</span> or <span class="kbd">`</span></span>
      </div>
      <div class="hero-grid">
        <div class="hero-text">
          <span class="eyebrow reveal">Computer Science + Business · USC</span>
          <h1 class="display hero-title reveal">
            Building <span class="accent">AI products</span>, autonomous <span class="accent">robots</span>, and software that <span class="accent">scales</span>.
          </h1>
          <p class="hero-tags reveal">AI &nbsp;•&nbsp; Robotics &nbsp;•&nbsp; Product &nbsp;•&nbsp; Leadership</p>
          <div class="links reveal">
            <a class="btn primary" href="#built">View Work</a>
            <a class="btn" href={SOCIAL.resume} target="_blank" rel="noopener">Résumé ↗</a>
          </div>
          <p class="resume-deep reveal">want the nuanced version? <a href={SOCIAL.resumeFull} target="_blank" rel="noopener">full two-page résumé →</a></p>
        </div>
        <div class="hero-photo detect reveal" data-detect="software engineer" data-conf="0.99">
          <span class="tag">human 0.99</span>
          <img src="/images/headshot.jpg" alt="Arsalan Ghogari" width="300" height="300" />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · ABOUT -->
  <section id="about" class="sec" data-detect="about" data-conf="0.96">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">02</span><h2 class="sec-title">About</h2></div>
      <div class="prose about io-reveal">
        <p>
          I'm studying Computer Science / Business Administration at USC's Viterbi and Marshall
          schools, specializing in AI Applications. I build perception systems for robots, AI tools
          that actually ship, and web platforms used by thousands of students.
        </p>
        <p>
          Mostly I like the part where a research-y idea turns into something people actually use —
          whether that's a robot that can see or a chatbot that answers a student's question at 2am.
          I'm back in LA after completing a <a href="https://arsalanghogari.com/postcards-from-bristol/" target="_blank" rel="noopener">study abroad semester</a> at the University of Bristol, and
          on the hunt for my next big project.
        </p>
      </div>
    </div>
  </section>

  <!-- 03 · CURRENT EXPERIENCES -->
  <section id="experience" class="sec" data-detect="experience.current" data-conf="0.97">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">03</span><h2 class="sec-title">Current Experiences</h2></div>
      <div class="roles">
        {CURRENT_ROLES.map((r) => <RoleCard role={r} />)}
      </div>
    </div>
  </section>

  <!-- 04 · PAST EXPERIENCES -->
  <section class="sec" data-detect="experience.past" data-conf="0.94">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">04</span><h2 class="sec-title">Past Experiences</h2></div>
      <div class="roles">
        {PAST_ROLES.map((r) => <RoleCard role={r} />)}
      </div>
    </div>
  </section>

  <!-- 05 · VOLUNTEERING -->
  <section id="volunteering" class="sec" data-detect="volunteering" data-conf="0.96">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">05</span><h2 class="sec-title">Volunteering</h2></div>
      <div class="roles">
        {VOLUNTEERING.map((r) => <RoleCard role={r} />)}
      </div>
    </div>
  </section>

  <!-- 06 · WHAT I'VE BUILT -->
  <section id="built" class="sec" data-detect="projects" data-conf="0.95">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">06</span><h2 class="sec-title">What I’ve Built</h2></div>

      <p class="subhead">Technical Projects &amp; Skills</p>
      <div class="grid">
        {TECHNICAL_PROJECTS.map((p) => (
          <a class="card io-reveal" href={p.href} target="_blank" rel="noopener">
            <span class="ptop">
              <span class="ptitle">{p.name}</span>
              {p.status === 'live' && <span class="badge"><span class="dot">●</span> Live</span>}
            </span>
            <span class="psub">{p.subtitle}</span>
            <span class="pblurb">{p.blurb}</span>
            <span class="ptech">{p.tech.join(' · ')}</span>
          </a>
        ))}
      </div>
      <div class="skills skills-block io-reveal">
        {TECH_SKILLS.map((s) => <span class="chip">{s}</span>)}
      </div>

      <p class="subhead nt-head">Non-Technical Projects &amp; Skills</p>
      <div class="nt-grid">
        {NON_TECHNICAL.map((n) => (
          <div class="nt-card io-reveal">
            <div class="nt-name">{n.name}</div>
            <p class="nt-blurb">{n.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 · EDUCATION -->
  <section id="education" class="sec" data-detect="education" data-conf="0.94">
    <div class="wrap">
      <div class="sec-head"><span class="sec-idx">07</span><h2 class="sec-title">Education</h2></div>
      <div class="edu io-reveal">
        <div class="edu-main">
          <h3 class="edu-school">{EDUCATION.school}</h3>
          <p class="edu-degree">{EDUCATION.degree}</p>
          <p class="edu-detail">{EDUCATION.detail}</p>
          <p class="edu-exchange">{EDUCATION.exchange}</p>
        </div>
        <div class="edu-honors">
          {EDUCATION.honors.map((h) => <span class="chip">{h}</span>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .hero { position: relative; padding: clamp(56px, 10vh, 120px) 0 clamp(46px, 8vh, 80px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .grid-bg { position: absolute; inset: 0; z-index: 0; }
  .hero .wrap { position: relative; z-index: 1; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    padding: 6px 12px;
    margin-bottom: 30px;
  }
  .status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good-dot); box-shadow: 0 0 0 3px color-mix(in srgb, var(--good-dot) 22%, transparent); }
  .status .sep { color: var(--line); }
  .mono-dim { color: var(--ink-faint); }
  .hero-grid { display: grid; grid-template-columns: 1fr 300px; gap: 56px; align-items: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; gap: 36px; } .hero-photo { order: -1; } }
  .eyebrow { display: block; margin-bottom: 20px; }
  .hero-title { font-size: clamp(2.3rem, 6vw, 4.4rem); max-width: 16ch; }
  .hero-tags { font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.04em; color: var(--ink-soft); margin: 24px 0 0; text-transform: uppercase; }
  .links { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }
  .resume-deep { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); margin: 14px 0 0; }
  .resume-deep a { color: var(--accent); text-decoration: none; }
  .resume-deep a:hover { text-decoration: underline; }
  .hero-photo { position: relative; width: 300px; max-width: 78vw; }
  .hero-photo img { width: 100%; height: auto; display: block; border: 1px solid var(--line); }

  /* roles (cards rendered by RoleCard.astro) */
  .roles { display: flex; flex-direction: column; border-top: 1px solid var(--line); }

  /* technical project cards */
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  .card { background: var(--panel); border: 1px solid var(--line); padding: 22px; text-decoration: none; display: flex; flex-direction: column; gap: 8px; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), border-color 0.2s var(--ease); }
  .card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 10px 0 -4px rgba(27, 42, 232, 0.12); }
  .ptop { display: flex; align-items: center; gap: 10px; }
  .ptitle { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; letter-spacing: -0.01em; flex: 1; }
  .card:hover .ptitle { color: var(--accent); }
  .psub { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
  .pblurb { color: var(--ink-soft); font-size: 0.96rem; flex: 1; }
  .ptech { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.05em; color: var(--ink-soft); text-transform: uppercase; border-top: 1px dashed var(--line); padding-top: 10px; }
  .badge { font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--good); border: 1px solid var(--good); padding: 1px 6px; white-space: nowrap; }
  .badge .dot { color: var(--good-dot); }
  .skills-block { margin-top: 18px; }

  /* non-technical */
  .nt-head { margin-top: 44px; }
  .nt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .nt-card { background: var(--paper); padding: 22px; }
  .nt-name { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.01em; }
  .nt-blurb { margin: 8px 0 0; color: var(--ink-soft); font-size: 0.95rem; }

  /* education */
  .edu { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .edu-school { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 4vw, 2.2rem); letter-spacing: -0.02em; margin: 0; }
  .edu-degree { margin: 10px 0 0; font-size: 1.1rem; }
  .edu-detail { margin: 4px 0 0; color: var(--ink-soft); }
  .edu-exchange { margin: 10px 0 0; font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent); }
  .edu-honors { display: flex; flex-wrap: wrap; gap: 8px; max-width: 320px; justify-content: flex-end; }

  .about p { margin: 0 0 16px; }
  .about a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    transition: border-color 0.15s ease;
  }
  .about a:hover { border-bottom-color: var(--accent); }
</style>
