---
// Isometric 2D-canvas simulation of the Barracuda AUV running a mission.
// No WebGL, no deps: everything is drawn in code each frame.
// Three modes mirror the autonomy stack: Perception → SLAM → Planning.
// Mission: 01 gate → 02 slalom → 03 bin drop. Overlays follow the task unless pinned.
const MODES = [
  { id: 'perception', idx: '01', label: 'Perception', caption: 'Detect. YOLO + RT-DETR on-vehicle.' },
  { id: 'slam', idx: '02', label: 'SLAM', caption: 'Localize. GTSAM factor graph, < 0.3 m error.' },
  { id: 'planning', idx: '03', label: 'Planning', caption: 'Navigate. Costmap + GPU-parallel MPPI, then drop.' },
];
---

<figure class="scene" id="scene" data-mode="perception">
  <span class="scene-tag"><span class="scene-dot"></span>illustrative simulation · barracuda auv</span>
  <canvas id="scene-canvas" aria-label="Animated isometric simulation of an autonomous underwater vehicle detecting props, building a map, and planning a path" role="img"></canvas>
  <figcaption class="scene-foot">
    <span class="scene-caption" id="scene-caption">{MODES[0].caption}</span>
    <div class="scene-ctl">
      <div class="scene-pills" role="tablist" aria-label="Simulation mode">
        {MODES.map((m, i) => (
          <button class={`pill${i === 0 ? ' on' : ''}`} role="tab" aria-selected={i === 0} data-mode={m.id} data-caption={m.caption}>
            <span class="pill-idx">{m.idx}</span>{m.label}
          </button>
        ))}
      </div>
      <button class="pause" id="scene-pause" aria-label="Pause animation" aria-pressed="false" title="Pause animation">
        <span class="pause-ico">❚❚</span>
      </button>
    </div>
  </figcaption>
</figure>

<style>
  .scene {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 560px;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%),
      var(--panel);
  }
  canvas { display: block; width: 100%; aspect-ratio: 1 / 1; }
  .scene-tag {
    position: absolute; top: 12px; right: 12px;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .scene-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .scene-foot {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 12px 14px 14px;
    display: flex; flex-direction: column; gap: 10px;
    background: linear-gradient(to top, color-mix(in srgb, var(--panel) 92%, transparent), transparent);
  }
  .scene-caption { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-soft); }
  .scene-ctl { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .scene-pills { display: inline-flex; gap: 10px; }
  .pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.02em;
    padding: 6px 11px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 80%, transparent); color: var(--ink-soft); cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .pill-idx { color: var(--accent); font-size: 0.6rem; letter-spacing: 0.08em; }
  .pill:hover { border-color: var(--accent); color: var(--ink); }
  .pill.on { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .pill.on .pill-idx { color: var(--paper); opacity: 0.7; }
  .pause {
    width: 30px; height: 30px;
    border: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 80%, transparent);
    color: var(--ink-soft); font-size: 0.55rem; cursor: pointer; display: grid; place-items: center;
  }
  .pause:hover { color: var(--accent); border-color: var(--accent); }
  .scene-ctl { flex-wrap: wrap; }
  @media (max-width: 640px) {
    .pill { padding: 5px 8px; }
    .pill-idx { display: none; }
    .scene-caption { font-size: 0.62rem; }
    .scene-foot { position: static; background: none; padding: 10px 12px 12px; }
    .scene-tag { font-size: 0.5rem; letter-spacing: 0.08em; white-space: nowrap; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('scene')!;
    const canvas = document.getElementById('scene-canvas') as HTMLCanvasElement;
    const caption = document.getElementById('scene-caption')!;
    const pauseBtn = document.getElementById('scene-pause')!;
    const ctx = canvas.getContext('2d')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- theme colors from CSS tokens
    const css = getComputedStyle(document.documentElement);
    const tok = (n: string) => css.getPropertyValue(n).trim();
    const C = { accent: tok('--accent'), good: tok('--good'), line: tok('--line'), ink: tok('--ink'), soft: tok('--ink-soft'), faint: tok('--ink-faint') };
    const rgb = (hex: string): [number, number, number] => { const n = parseInt(hex.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
    const alpha = (hex: string, a: number) => `rgba(${rgb(hex).join(',')},${a})`;
    const ACC = rgb(C.accent);

    // ---- world → screen (2:1 isometric)
    let W = 0, S = 0, CX = 0, CY = 0;
    type V3 = [number, number, number];
    type P2 = [number, number];
    const iso = ([x, y, z]: V3): P2 => [CX + (x - y) * S, CY + (x + y) * S * 0.5 - z * S];
    const GRID = 12;

    // ---- world: props + mission
    type Prop = { id: string; label: string; x: number; y: number; kind: 'gate' | 'pole' | 'bin'; conf: number };
    const GATE = { x: 6, y: 2.5, half: 0.9, h: 2.1 };
    const BIN = { x: 4.5, y: 10 };
    const props: Prop[] = [
      { id: 'gate', label: 'gate', x: GATE.x, y: GATE.y, kind: 'gate', conf: 0.93 },
      { id: 'p1', label: 'pole', x: 10.5, y: 5.5, kind: 'pole', conf: 0.9 },
      { id: 'p2', label: 'pole', x: 10.5, y: 7.2, kind: 'pole', conf: 0.87 },
      { id: 'p3', label: 'pole', x: 10.5, y: 8.9, kind: 'pole', conf: 0.89 },
      { id: 'bin', label: 'bin', x: BIN.x, y: BIN.y, kind: 'bin', conf: 0.91 },
    ];
    // waypoints, with the task each segment belongs to (0 gate, 1 slalom, 2 bin)
    const waypoints: P2[] = [[1.5, 1.5], [3, 2.5], [9.2, 2.5], [11.2, 3.8], [9.5, 5.5], [11.5, 7.2], [9.5, 8.9], [9.8, 10.8], [BIN.x, BIN.y], [1.5, 7]];
    const taskOf = [0, 0, 1, 1, 1, 1, 2, 2, 2, 0];
    const segLen = waypoints.map((p, i) => { const q = waypoints[(i + 1) % waypoints.length]; return Math.hypot(q[0] - p[0], q[1] - p[1]); });
    const total = segLen.reduce((a, b) => a + b, 0);
    const binDist = segLen.slice(0, 8).reduce((a, b) => a + b, 0); // arc length at the bin
    const SPEED = 1.1; // world units / s

    function segAt(d: number) {
      d = ((d % total) + total) % total;
      let i = 0;
      while (d > segLen[i]) { d -= segLen[i]; i = (i + 1) % waypoints.length; }
      return { i, u: d / segLen[i] };
    }
    function posAt(d: number): P2 {
      const { i, u } = segAt(d);
      const p = waypoints[i], q = waypoints[(i + 1) % waypoints.length];
      return [p[0] + (q[0] - p[0]) * u, p[1] + (q[1] - p[1]) * u];
    }
    // average a few samples around d for rounded corners
    const smooth = (d: number): P2 => {
      let x = 0, y = 0; const K = 7, R = 0.55;
      for (let k = 0; k < K; k++) { const [a, b] = posAt(d + (k / (K - 1) - 0.5) * 2 * R); x += a; y += b; }
      return [x / K, y / K];
    };

    // ---- state
    const MODE_OF_TASK = ['perception', 'slam', 'planning'];
    let mode = 'perception';
    let pinned = false;
    let paused = false;
    let visible = true;
    let dist = 0, last = 0;
    const trail: P2[] = [];
    const seen: Record<string, number> = {};
    const lmEst: Record<string, P2> = {};
    for (const p of props) lmEst[p.id] = [p.x + 0.45, p.y - 0.35];
    let jitterT = 0; const confJ: Record<string, number> = {};
    // gripper payload: held until the sub is over the bin, then falls in
    let held = true, dropT = -1;

    // ---- primitives
    function poly(pts: P2[], fill: string, stroke?: string) {
      ctx.beginPath(); ctx.moveTo(pts[0][0], pts[0][1]);
      for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
      ctx.closePath(); ctx.fillStyle = fill; ctx.fill();
      if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1; ctx.stroke(); }
    }
    const shade = (base: [number, number, number], k: number) =>
      `rgb(${base.map((c) => Math.max(0, Math.min(255, Math.round(c * k)))).join(',')})`;
    // Rotated box: center (x,y,z0), size l×w×h, heading θ. Camera-facing faces, painter-sorted.
    function box(x: number, y: number, z0: number, l: number, w: number, h: number, th: number, base: [number, number, number], edge?: string) {
      const c = Math.cos(th), s = Math.sin(th);
      const corner = (dx: number, dy: number, z: number): V3 => [x + dx * c - dy * s, y + dx * s + dy * c, z];
      const hl = l / 2, hw = w / 2;
      const b = [corner(-hl, -hw, z0), corner(hl, -hw, z0), corner(hl, hw, z0), corner(-hl, hw, z0)];
      const t = b.map(([a, bb]) => [a, bb, z0 + h] as V3);
      const faces: { pts: V3[]; n: P2 }[] = [];
      for (let i = 0; i < 4; i++) {
        const j = (i + 1) % 4;
        const nx = b[j][1] - b[i][1], ny = -(b[j][0] - b[i][0]);
        const len = Math.hypot(nx, ny) || 1;
        faces.push({ pts: [b[i], b[j], t[j], t[i]], n: [nx / len, ny / len] });
      }
      const vis = faces.filter((f) => f.n[0] + f.n[1] > 0.01);
      vis.sort((a, b2) => (a.pts[0][0] + a.pts[0][1] + a.pts[1][0] + a.pts[1][1]) - (b2.pts[0][0] + b2.pts[0][1] + b2.pts[1][0] + b2.pts[1][1]));
      for (const f of vis) poly(f.pts.map(iso), shade(base, 0.62 + 0.3 * (f.n[0] * 0.9 + f.n[1] * 0.2)), edge);
      poly(t.map(iso), shade(base, 1.08), edge);
      return { b, t };
    }
    function shadow(x: number, y: number, rx: number, ry: number, a = 0.3) {
      const [px, py] = iso([x, y, 0]);
      ctx.beginPath(); ctx.ellipse(px, py, rx * S, ry * S * 0.5, 0, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(0,0,0,${a})`; ctx.fill();
    }
    function text(s: string, x: number, y: number, color = C.soft, size = 0.24) {
      ctx.font = `${Math.max(9, S * size)}px JetBrains Mono, monospace`; ctx.fillStyle = color; ctx.fillText(s, x, y);
    }
    function dashed(pts: P2[], color: string, dash: number[], width = 1) {
      if (pts.length < 2) return;
      ctx.setLineDash(dash); ctx.strokeStyle = color; ctx.lineWidth = width;
      ctx.beginPath(); ctx.moveTo(pts[0][0], pts[0][1]); for (const p of pts.slice(1)) ctx.lineTo(p[0], p[1]); ctx.stroke();
      ctx.setLineDash([]);
    }

    // ---- drawables
    function floor() {
      ctx.strokeStyle = alpha(C.line, 0.9); ctx.lineWidth = 1;
      for (let i = 0; i <= GRID; i++) {
        let [a, b] = iso([i, 0, 0]); let [c, d] = iso([i, GRID, 0]);
        ctx.beginPath(); ctx.moveTo(a, b); ctx.lineTo(c, d); ctx.stroke();
        [a, b] = iso([0, i, 0]); [c, d] = iso([GRID, i, 0]);
        ctx.beginPath(); ctx.moveTo(a, b); ctx.lineTo(c, d); ctx.stroke();
      }
    }
    function costmap() {
      for (let i = 0; i < GRID; i++) for (let j = 0; j < GRID; j++) {
        let cost = 0;
        for (const p of props) { const d = Math.hypot(i + 0.5 - p.x, j + 0.5 - p.y); cost = Math.max(cost, Math.exp(-(d * d) / 1.6)); }
        if (cost < 0.05) continue;
        poly([iso([i, j, 0]), iso([i + 1, j, 0]), iso([i + 1, j + 1, 0]), iso([i, j + 1, 0])], alpha(C.accent, cost * 0.4));
      }
    }
    const HULL: [number, number, number] = [96, 108, 128];
    const WOOD: [number, number, number] = [120, 70, 50];
    const SUBZ = 1.1;
    const TRASH: [number, number, number] = [150, 120, 90];
    function sub(x: number, y: number, th: number, t: number) {
      const bob = Math.sin(t * 1.7) * 0.06, z = SUBZ + bob;
      const c = Math.cos(th), s = Math.sin(th);
      shadow(x, y, 0.9, 0.9);
      for (const [dx, dy] of [[-0.55, -0.42], [0.55, -0.42], [-0.55, 0.42], [0.55, 0.42]])
        box(x + dx * c - dy * s, y + dx * s + dy * c, z - 0.05, 0.28, 0.14, 0.14, th, [60, 66, 80]);
      // gripper: two fingers under the hull; closed on the payload, open after the drop
      const gap = held ? 0.14 : 0.3;
      for (const sgn of [-1, 1]) box(x - sgn * gap * s, y + sgn * gap * c, z - 0.32, 0.12, 0.06, 0.3, th, [70, 76, 90]);
      if (held) box(x, y, z - 0.3, 0.26, 0.2, 0.2, th, TRASH);
      box(x, y, z, 1.7, 0.62, 0.42, th, HULL, alpha(C.ink, 0.12));
      box(x, y, z + 0.42, 1.1, 0.3, 0.16, th, ACC);
      const [nx, ny] = iso([x + 0.85 * c, y + 0.85 * s, z + 0.22]);
      ctx.beginPath(); ctx.arc(nx, ny, S * 0.11, 0, Math.PI * 2); ctx.fillStyle = C.good; ctx.fill();
    }
    // drops a payload from the gripper into the bin; returns true while still visible
    function payload(t: number) {
      const u = Math.min(1, (t - dropT) / 0.7);
      const z = SUBZ - 0.3 - (SUBZ - 0.3 - 0.45) * u * u;
      box(BIN.x, BIN.y, z, 0.26, 0.2, 0.2, 2.6, TRASH);
    }

    // ---- entities (painter-sorted by x+y). Each returns projected points for bounding boxes.
    type Ent = { d: number; p?: Prop; f: () => P2[] | void };
    const pts8 = (r: { b: V3[]; t: V3[] }) => [...r.b, ...r.t].map(iso);
    function entities(x: number, y: number, th: number, t: number): Ent[] {
      const e: Ent[] = [];
      const g = props[0];
      // gate split into three parts so the sub can pass under the bar
      e.push({ d: g.x + g.y - GATE.half, f: () => { shadow(g.x, g.y, 0.4, 1.2, 0.2); return pts8(box(g.x, g.y - GATE.half, 0, 0.18, 0.18, GATE.h, 0, WOOD)); } });
      e.push({ d: g.x + g.y + 0.5, p: g, f: () => pts8(box(g.x, g.y, GATE.h - 0.07, 0.14, GATE.half * 2 + 0.18, 0.14, 0, [230, 120, 60])) });
      e.push({ d: g.x + g.y + GATE.half, f: () => pts8(box(g.x, g.y + GATE.half, 0, 0.18, 0.18, GATE.h, 0, WOOD)) });
      for (const p of props) {
        if (p.kind === 'pole') e.push({ d: p.x + p.y, p, f: () => { shadow(p.x, p.y, 0.25, 0.25, 0.2); return pts8(box(p.x, p.y, 0, 0.16, 0.16, 1.9, 0, [230, 120, 60])); } });
        if (p.kind === 'bin') e.push({ d: p.x + p.y, p, f: () => {
          shadow(p.x, p.y, 0.8, 0.8, 0.25);
          const r = box(p.x, p.y, 0, 1.1, 1.1, 0.5, 0.25, [70, 90, 110]);
          const [ix, iy] = iso([p.x, p.y, 0.5]);
          ctx.beginPath(); ctx.ellipse(ix, iy, S * 0.38, S * 0.19, 0, 0, Math.PI * 2); ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fill();
          return pts8(r);
        } });
      }
      if (!held && dropT >= 0 && t - dropT < 0.7) e.push({ d: BIN.x + BIN.y + 0.01, f: () => { payload(t); } });
      e.push({ d: x + y, f: () => { sub(x, y, th, t); } });
      return e.sort((a, b) => a.d - b.d);
    }

    function bracketBox(x0: number, y0: number, x1: number, y1: number, label: string) {
      const pad = 6; x0 -= pad; y0 -= pad; x1 += pad; y1 += pad;
      ctx.strokeStyle = C.accent; ctx.lineWidth = 1.2; ctx.strokeRect(x0, y0, x1 - x0, y1 - y0);
      const k = 7; ctx.lineWidth = 2.2;
      for (const [cx, cy, sx, sy] of [[x0, y0, 1, 1], [x1, y0, -1, 1], [x0, y1, 1, -1], [x1, y1, -1, -1]]) {
        ctx.beginPath(); ctx.moveTo(cx, cy + sy * k); ctx.lineTo(cx, cy); ctx.lineTo(cx + sx * k, cy); ctx.stroke();
      }
      ctx.font = `${Math.max(9, S * 0.26)}px JetBrains Mono, monospace`;
      const tw = ctx.measureText(label).width + 10;
      ctx.fillStyle = C.accent; ctx.fillRect(x0, y0 - 15, tw, 15);
      ctx.fillStyle = '#fff'; ctx.fillText(label, x0 + 5, y0 - 4);
    }
    function fov(x: number, y: number, th: number) {
      const R = 4.2, half = 0.6;
      const pts: P2[] = [iso([x, y, 0.02])];
      for (let a = -half; a <= half + 1e-6; a += half / 6) pts.push(iso([x + Math.cos(th + a) * R, y + Math.sin(th + a) * R, 0.02]));
      poly(pts, alpha(C.good, 0.1), alpha(C.good, 0.35));
    }
    function inFov(x: number, y: number, th: number, p: Prop) {
      const d = Math.hypot(p.x - x, p.y - y); if (d > 4.4 || d < 0.3) return false;
      let a = Math.atan2(p.y - y, p.x - x) - th; a = Math.atan2(Math.sin(a), Math.cos(a));
      return Math.abs(a) < 0.62;
    }

    // ---- frame
    function draw(t: number) {
      ctx.clearRect(0, 0, W, W);
      const [x, y] = smooth(dist);
      const [ax, ay] = smooth(dist + 0.35);
      const th = Math.atan2(ay - y, ax - x);

      floor();
      if (mode === 'planning') costmap();
      if (mode === 'perception') fov(x, y, th);
      if (mode === 'slam') {
        dashed(trail.map(([a, b]) => iso([a, b, 0.03])), alpha(C.good, 0.7), [3, 4], 1.2);
        for (let i = 0; i < trail.length; i += 12) { const [px, py] = iso([trail[i][0], trail[i][1], 0.03]); ctx.fillStyle = C.good; ctx.fillRect(px - 2, py - 2, 4, 4); }
        for (const p of props) {
          const [gx, gy] = iso([p.x, p.y, 0.02]);
          ctx.beginPath(); ctx.ellipse(gx, gy, 0.3 * S * 1.2, 0.3 * S * 0.6, 0, 0, Math.PI * 2);
          ctx.strokeStyle = alpha(C.ink, 0.35); ctx.setLineDash([2, 3]); ctx.lineWidth = 1; ctx.stroke(); ctx.setLineDash([]);
          const e = lmEst[p.id]; const [ex, ey] = iso([e[0], e[1], 0.02]);
          ctx.beginPath(); ctx.arc(ex, ey, 3, 0, Math.PI * 2); ctx.fillStyle = C.accent; ctx.fill();
          if (seen[p.id]) { const err = Math.hypot(e[0] - p.x, e[1] - p.y); text(`${p.label} ±${err.toFixed(2)} m`, ex + 7, ey + 4, err < 0.3 ? C.good : C.accent, 0.22); }
        }
      }
      if (mode === 'planning') {
        const ahead: P2[] = [];
        for (let d = 0; d < 5; d += 0.25) { const [a, b] = smooth(dist + d); ahead.push(iso([a, b, 0.03])); }
        for (let r = 0; r < 9; r++) {
          const pts: P2[] = [];
          const bias = (r - 4) * 0.09, wob = Math.sin(t * 2 + r * 1.7) * 0.05;
          for (let d = 0; d < 3.2; d += 0.25) { const [a, b] = smooth(dist + d); const k = d * d * 0.12; pts.push(iso([a + Math.cos(th + Math.PI / 2) * (bias + wob) * k * 4, b + Math.sin(th + Math.PI / 2) * (bias + wob) * k * 4, 0.03])); }
          dashed(pts, alpha(C.accent, 0.22), [], 1);
        }
        dashed(ahead, C.good, [6, 4], 1.6);
      }

      const boxes: { p: Prop; pts: P2[] }[] = [];
      for (const e of entities(x, y, th, t)) { const pts = e.f(); if (e.p && pts) boxes.push({ p: e.p, pts }); }

      if (mode === 'perception') {
        for (const { p, pts } of boxes) {
          if (!inFov(x, y, th, p)) continue;
          seen[p.id] = (seen[p.id] || 0) + 1;
          let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
          for (const [a, b] of pts) { x0 = Math.min(x0, a); y0 = Math.min(y0, b); x1 = Math.max(x1, a); y1 = Math.max(y1, b); }
          if (p.kind === 'gate') { y1 = Math.max(y1, iso([p.x, p.y + GATE.half, 0])[1]); x0 = Math.min(x0, iso([p.x, p.y + GATE.half, 0])[0]); x1 = Math.max(x1, iso([p.x, p.y - GATE.half, 0])[0]); }
          bracketBox(x0, y0, x1, y1, `${p.label} ${(p.conf + (confJ[p.id] || 0)).toFixed(2)}`);
        }
      }
      if (mode === 'slam') {
        for (const p of props) if (inFov(x, y, th, p)) {
          seen[p.id] = (seen[p.id] || 0) + 1;
          const e = lmEst[p.id]; dashed([iso([x, y, SUBZ]), iso([e[0], e[1], 0.02])], alpha(C.accent, 0.6), [2, 3]);
        }
      }
      text(`pose  x ${x.toFixed(2)}  y ${y.toFixed(2)}  ψ ${((th * 180) / Math.PI).toFixed(0)}°`, 14, 44, C.faint, 0.22);
    }

    function setMode(m: string) {
      if (m === mode) return;
      mode = m; root.dataset.mode = m;
      root.querySelectorAll<HTMLButtonElement>('.pill').forEach((p) => {
        const on = p.dataset.mode === m; p.classList.toggle('on', on); p.setAttribute('aria-selected', String(on));
        if (on) caption.textContent = p.dataset.caption || '';
      });
    }

    function step(now: number) {
      if (!last) last = now;
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (!paused) {
        const before = dist;
        dist += SPEED * dt;
        if (Math.floor(before / total) !== Math.floor(dist / total)) { held = true; dropT = -1; } // new lap: payload reloaded
        if (held && (dist % total) >= binDist) { held = false; dropT = now / 1000; }
        const [x, y] = smooth(dist);
        trail.push([x, y]); if (trail.length > 420) trail.shift();
        for (const p of props) if (seen[p.id]) { const e = lmEst[p.id]; e[0] += (p.x + 0.12 - e[0]) * dt * 0.6; e[1] += (p.y - 0.09 - e[1]) * dt * 0.6; }
        jitterT += dt; if (jitterT > 0.3) { jitterT = 0; for (const p of props) confJ[p.id] = (Math.random() - 0.5) * 0.06; }
        if (!pinned) setMode(MODE_OF_TASK[taskOf[segAt(dist).i]]);
      }
      draw(now / 1000);
      if (visible && !reduced) requestAnimationFrame(step); else last = 0;
    }

    // ---- sizing
    function resize() {
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = canvas.clientWidth; canvas.width = W * dpr; canvas.height = W * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      S = W / 15.5; CX = W / 2; CY = W * 0.5 - GRID * S * 0.5 + S * 0.2;
      if (reduced) draw(0);
    }
    new ResizeObserver(resize).observe(canvas);
    resize();

    // ---- controls
    root.querySelectorAll<HTMLButtonElement>('.pill').forEach((b) => b.addEventListener('click', () => { pinned = true; setMode(b.dataset.mode!); }));
    function setPaused(v: boolean) {
      paused = v; pauseBtn.setAttribute('aria-pressed', String(v)); pauseBtn.setAttribute('aria-label', v ? 'Play animation' : 'Pause animation');
      pauseBtn.querySelector('.pause-ico')!.textContent = v ? '▶' : '❚❚';
    }
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    window.addEventListener('toggle-motion', () => setPaused(!paused));
    new IntersectionObserver(([e]) => { const was = visible; visible = e.isIntersecting; if (visible && !was && !reduced) requestAnimationFrame(step); }).observe(root);
    if (!reduced) requestAnimationFrame(step); else { dist = 8; for (let d = 0; d < 8; d += 0.05) trail.push(smooth(d)); seen.gate = 1; setPaused(true); draw(0); }
  })();
</script>
