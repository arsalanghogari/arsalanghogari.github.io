---
import type { Role } from '../data/content';
import IcpTile from './IcpTile.astro';
interface Props { role: Role; }
const { role: r } = Astro.props;
---

<article class={`role io-reveal${r.media ? ' has-media' : ''}`}>
  <div class="role-text">
    <div class="role-head">
      <h3 class="role-title">
        {r.role} · {r.orgHref
          ? <a class="role-org" href={r.orgHref} target="_blank" rel="noopener">{r.org}</a>
          : <span class="role-org">{r.org}</span>}
      </h3>
      <span class="role-date">{r.date}</span>
    </div>
    <p class="role-blurb">{r.blurb}</p>
    <div class="skills">{r.tags.map((t) => <span class="chip">{t}</span>)}</div>
  </div>

  {r.media && (
    <div class="role-media">
      {r.media.kind === 'icp' ? (
        <IcpTile />
      ) : r.media.kind === 'logo' ? (
        <div class="logo-tile"><img src={r.media.src} alt={r.media.alt} loading="lazy" /></div>
      ) : r.media.kind === 'shot' && r.orgHref ? (
        <div class="live-frame" data-live>
          <div class="lf-bar"><span></span><span></span><span></span><span class="lf-url">{r.orgHref.replace(/^https?:\/\//, '')}</span><span class="lf-tag">live · scroll inside</span></div>
          <div class="lf-view">
            <img class="lf-poster" src={r.media.src} alt={r.media.alt} loading="lazy" />
            <iframe src={r.orgHref} title={`${r.org} website, live`} loading="lazy" tabindex="-1" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups allow-forms"></iframe>
          </div>
        </div>
      ) : (
        <img class={`media-img ${r.media.kind}`} src={r.media.src} alt={r.media.alt} loading="lazy" />
      )}
    </div>
  )}
</article>

<style>
  .role { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .role.has-media {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 30px;
    align-items: start;
  }
  @media (max-width: 640px) {
    .role.has-media { grid-template-columns: 1fr; gap: 16px; }
    .role-media { max-width: 380px; }
  }
  .role-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 18px; }
  .role-title { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.01em; margin: 0; }
  .role-org { color: var(--accent); }
  a.role-org { text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  a.role-org:hover { border-bottom-color: var(--accent); }
  .role-date { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; color: var(--ink-soft); text-transform: uppercase; white-space: nowrap; }
  .role-blurb { margin: 10px 0 12px; color: var(--ink-soft); font-size: 1.02rem; max-width: 70ch; }

  .media-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--line);
    display: block;
  }
  /* screenshots: show the whole page (natural aspect, no crop) */
  .media-img.shot { aspect-ratio: auto; height: auto; object-fit: contain; }
  .media-img.photo { object-position: center 36%; }
  /* live site embed: a scaled-down browser window, poster until the page loads */
  .live-frame { border: 1px solid var(--line); background: var(--panel); }
  .lf-bar { display: flex; align-items: center; gap: 5px; padding: 6px 8px; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.06em; color: var(--ink-faint); white-space: nowrap; overflow: hidden; }
  .lf-bar > span:nth-child(-n+3) { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
  .lf-url { margin-left: 6px; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; }
  .lf-tag { margin-left: auto; text-transform: uppercase; color: var(--good); flex: none; }
  @container (max-width: 260px) { .lf-tag { display: none; } }
  .live-frame { container-type: inline-size; }
  .lf-view { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #fff; }
  .lf-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: opacity 0.4s; }
  .lf-view iframe { position: absolute; top: 0; left: 0; width: 400%; height: 400%; border: 0; transform: scale(0.25); transform-origin: 0 0; opacity: 0; transition: opacity 0.4s; pointer-events: none; }
  .live-frame.loaded .lf-poster { opacity: 0; }
  .live-frame.loaded iframe { opacity: 1; }
  .live-frame.loaded:hover iframe { pointer-events: auto; }
  .logo-tile {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
  }
  .logo-tile img { width: 100%; max-width: 150px; height: auto; display: block; }
</style>

<script>
  // swap the poster for the live page once the iframe has rendered
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((f) => {
    const fr = f.querySelector('iframe')!;
    const ok = () => f.classList.add('loaded');
    fr.addEventListener('load', ok);
  });
</script>
