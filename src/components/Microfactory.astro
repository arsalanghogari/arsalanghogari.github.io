---
// PTDrone Microfactory V6, the real GLB from the PTDrone site, rendered live
// with three.js. Loads only when scrolled into view (1.75 MB Draco GLB),
// auto-orbits, drag to rotate, stops when off screen.
---

<figure class="mf" data-mf>
  <canvas class="mf-canvas" aria-label="Interactive 3D model of the PTDrone Microfactory V6 container; hover to peel the shell away and see inside, drag to rotate" role="img"></canvas>
  <span class="mf-tag"><svg class="mf-mark" viewBox="-0.5 -0.5 101 78.5" aria-hidden="true"><path d="M0.0 -0.07 1.78 1.85 13.31 12.8 49.63 12.72 40.98 20.64 11.02 20.71 11.02 46.3 23.82 59.54 23.89 29.88 37.28 29.81 43.2 30.55 46.15 30.55 52.81 25.22 67.53 12.72 60.95 5.84 54.44 -0.07ZM69.38 15.16 46.6 34.1 38.68 40.09 50.22 40.24 50.3 77.44 64.72 65.68 64.72 29.14 82.99 29.07 99.93 15.24Z" /></svg>microfactory v6 · concept model</span>
  <span class="mf-hint">hover to peel · drag to rotate</span>
  <span class="mf-load" data-mf-load>loading model…</span>
</figure>

<style>
  .mf { position: relative; margin: 6px 0 2px; border: 1px solid var(--line); background: var(--paper); aspect-ratio: 2.6 / 1; overflow: hidden; cursor: grab; touch-action: pan-y; }
  .mf:active { cursor: grabbing; }
  .mf-canvas { display: block; width: 100%; height: 100%; }
  .mf-tag { position: absolute; top: 8px; left: 10px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); }
  .mf-mark { height: 11px; width: auto; fill: var(--ink); }
  .mf-hint, .mf-load { position: absolute; right: 10px; bottom: 8px; font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .mf-load { right: auto; left: 10px; color: var(--accent); }
  .mf-hint { pointer-events: none; }
  .mf.ready .mf-load { display: none; }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-mf]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    let started = false;
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting && !started) { started = true; io.disconnect(); boot(); } }, { rootMargin: '200px' });
    io.observe(root);

    async function boot() {
      const [THREE, { GLTFLoader }, { DRACOLoader }] = await Promise.all([
        import('three'),
        import('three/examples/jsm/loaders/GLTFLoader.js'),
        import('three/examples/jsm/loaders/DRACOLoader.js'),
      ]);
      const css = getComputedStyle(document.documentElement);
      const tok = (n: string) => css.getPropertyValue(n).trim();

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(2, devicePixelRatio));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.localClippingEnabled = true;
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 2.6, 0.1, 100);

      scene.add(new THREE.HemisphereLight(0xffffff, 0x9a9a90, 1.6));
      const key = new THREE.DirectionalLight(0xffffff, 2.2); key.position.set(5, 8, 6); scene.add(key);
      const fill = new THREE.DirectionalLight(0xffffff, 0.8); fill.position.set(-6, 3, -4); scene.add(fill);

      // ground shadow disc in the site's line color
      const disc = new THREE.Mesh(new THREE.CircleGeometry(4.6, 48), new THREE.MeshBasicMaterial({ color: tok('--line'), transparent: true, opacity: 0.6 }));
      disc.rotation.x = -Math.PI / 2; disc.position.y = -0.01; scene.add(disc);

      const pivot = new THREE.Group(); scene.add(pivot);
      const draco = new DRACOLoader(); draco.setDecoderPath('/draco/');
      const loader = new GLTFLoader(); loader.setDRACOLoader(draco);
      const gltf = await loader.loadAsync('/models/microfactory.glb');
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3()), center = box.getCenter(new THREE.Vector3());
      model.position.sub(center); model.position.y += size.y / 2; // sit on the disc
      pivot.add(model);
      // a lamp inside so the opened container shows lit cells
      const lamp = new THREE.PointLight(0xffffff, 40, size.x * 1.6, 2); lamp.position.set(0, size.y * 0.55, 0); pivot.add(lamp);
      // shell sweep: on hover a cut plane sweeps along the container and peels
      // the outer shell away, exposing the cells; it sweeps back on leave.
      // Shell = any mesh under a CONTAINER_* node taller than 1 m (walls, roof,
      // light rails). Only shell materials carry the clipping plane.
      const plane = new THREE.Plane(new THREE.Vector3(-1, 0, 0), 1e3);
      const bb = new THREE.Box3();
      let shellCount = 0;
      model.traverse((n: any) => {
        if (!/^CONTAINER_/.test(n.name)) return;
        n.traverse((o: any) => {
          if (!o.isMesh) return;
          bb.setFromObject(o);
          if (bb.max.y - bb.min.y > 1.0 || bb.min.y > 1.0) {
            o.material = [o.material].flat().map((m: any) => { const c = m.clone(); c.clippingPlanes = [plane]; c.side = THREE.DoubleSide; return c; });
            if (o.material.length === 1) o.material = o.material[0];
            shellCount++;
          }
        });
      });
      const half = size.x / 2 + 0.05;
      let hover = false, sweep = 0;
      root.addEventListener('pointerenter', () => { hover = true; });
      root.addEventListener('pointerleave', () => { hover = false; });
      function updateSweep(dt: number) {
        sweep += ((hover ? 1 : 0) - sweep) * Math.min(1, dt * 3);
        const k = sweep < 0.5 ? 2 * sweep * sweep : 1 - Math.pow(-2 * sweep + 2, 2) / 2;
        // keep the cut fixed to the model as it turns: local +x in world space
        plane.normal.set(-Math.cos(yaw), 0, Math.sin(yaw));
        plane.constant = half - 2 * half * k; // k=0 keeps all, k=1 removes all
      }
      const R = Math.max(size.x, size.z) * 1.15;
      camera.position.set(R * 0.9, R * 0.6, R * 0.9);
      camera.lookAt(0, size.y * 0.35, 0);
      root.classList.add('ready');

      // orbit: auto-spin + drag
      let yaw = 0.6, vel = reduced ? 0 : 0.25, drag: { x: number; yaw: number } | null = null, lastX = 0;
      root.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, yaw }; lastX = e.clientX; root.setPointerCapture(e.pointerId); });
      root.addEventListener('pointermove', (e) => { if (!drag) return; vel = (e.clientX - lastX) * 0.15; lastX = e.clientX; yaw = drag.yaw + (e.clientX - drag.x) * 0.008; });
      const up = () => { drag = null; }; root.addEventListener('pointerup', up); root.addEventListener('pointercancel', up);
      root.addEventListener('click', (e) => e.preventDefault());

      function resize() {
        const w = root.clientWidth, h = root.clientHeight;
        if (canvas.width !== w * renderer.getPixelRatio() || canvas.height !== h * renderer.getPixelRatio()) {
          renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();
        }
      }
      let on = true, last = 0;
      const frame = (now: number) => {
        if (!on) return;
        const dt = Math.min(0.05, (now - last) / 1000 || 0); last = now;
        if (!drag) { yaw += vel * dt; vel += ((reduced || hover ? 0 : 0.25) * Math.sign(vel || 1) - vel) * Math.min(1, dt * 1.5); }
        pivot.rotation.y = yaw;
        updateSweep(dt);
        resize(); renderer.render(scene, camera);
        requestAnimationFrame(frame);
      };
      new IntersectionObserver(([e]) => { const was = on; on = e.isIntersecting; if (on && !was) { last = 0; requestAnimationFrame(frame); } }).observe(root);
      requestAnimationFrame(frame);
      if (reduced) { on = false; resize(); pivot.rotation.y = yaw; renderer.render(scene, camera); }
    }
  });
</script>
