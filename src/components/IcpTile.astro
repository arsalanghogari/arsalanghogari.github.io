---
// Role tile for the USC Industry Collaboration Program: the crane carries an
// AI chip whose traces wire the floors of the building under construction.
// building frame: bays × floors of rects, origin bottom-left
const frameRects = (x0: number, y0: number, bw = 34, fh = 30, bays = 3, floors = 4) =>
  Array.from({ length: floors }, (_, f) => Array.from({ length: bays }, (_, b) => ({ x: x0 + b * bw, y: y0 - (f + 1) * fh, w: bw, h: fh }))).flat();
// tower crane: mast, lattice, jib, tie-backs; hook returned separately
const craneLines = (x: number, top: number, ground: number, jib = 120) => {
  const L: [number, number, number, number][] = [[x, ground, x, top], [x + 10, ground, x + 10, top]];
  for (let i = 0; i < Math.floor((ground - top) / 22); i++) L.push([x, ground - i * 22, x + 10, ground - (i + 1) * 22]);
  L.push([x - 30, top, x + jib, top], [x - 30, top, x + 5, top - 16], [x + 5, top - 16, x + jib, top]);
  return { lines: L, hook: { x: x + jib * 0.6, y1: top, y2: top + 60 } };
};
---

<svg class="icp" viewBox="0 0 400 300" role="img" aria-label="USC Industry Collaboration Program: AI for a construction company" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#990000" />
  <image href="/images/usc-logo.png" x="22" y="16" width="110" height="44" />
  <line class="gold draw" x1="24" y1="262" x2="376" y2="262" />

  <g>
      <g class="gold"><g>{frameRects(44, 262, 36, 30, 3, 4).map((r) => <rect class="draw" x={r.x} y={r.y} width={r.w} height={r.h} />)}</g><g>{craneLines(230, 96, 262, 120).lines.map(([x1, y1, x2, y2]) => <line class="draw" x1={x1} y1={y1} x2={x2} y2={y2} />)}{(() => { const h = craneLines(230, 96, 262, 120).hook; return <><line class="draw hook" x1={h.x} y1={h.y1} x2={h.x} y2={h.y2} /><rect class="draw hook" x={h.x - 10} y={h.y2} width="20" height="10" /></>; })()}</g></g>
      <g class="chip"><rect x="284" y="156" width="36" height="28" rx="3" /><text x="302" y="174" text-anchor="middle">AI</text>
        {[0, 1, 2, 3].map((i) => <line x1={288 + i * 9} y1="156" x2={288 + i * 9} y2="150" />)}</g>
      {[0, 1, 2, 3].map((i) => {
        const y = 262 - i * 30 - 15; const d = `M284,${170} L252,${170} L252,${y} L152,${y}`;
        return <g><path class="trace" d={d} /><circle class="pulse" r="3" style={`offset-path: path('${d}'); animation-delay:${i * 0.7}s`} /></g>;
      })}
      <text class="cap" x="44" y="282">MODEL OUTPUT WIRED INTO THE BUILD</text>
  </g>

</svg>

<style>
  .icp { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .gold { fill: none; stroke: #ffcc00; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cap { font-family: var(--font-mono); font-size: 7.5px; letter-spacing: 0.12em; fill: #ffe9a6; fill-opacity: 0.75; }
  text { font-family: var(--font-mono); }

  .draw { stroke-dasharray: 420; stroke-dashoffset: 420; }
  :global(.in) .draw { animation: draw 1.6s cubic-bezier(0.2, 0.65, 0.3, 1) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

        .chip rect { fill: #990000; stroke: #ffcc00; stroke-width: 1.6; } .chip line { stroke: #ffcc00; stroke-width: 1.6; }
  .chip text { font-size: 10px; fill: #ffcc00; font-weight: 700; }
  .trace { fill: none; stroke: #ffe9a6; stroke-opacity: 0.45; stroke-width: 1; }
  .pulse { fill: #fff; animation: travel 2.8s linear infinite; animation-play-state: paused; }
  :global(.in) .pulse { animation-play-state: running; }
  @keyframes travel { 0% { offset-distance: 0%; opacity: 0; } 5% { opacity: 1; } 60% { offset-distance: 100%; opacity: 1; } 62%, 100% { offset-distance: 100%; opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
    .icp * { animation: none !important; }
    .draw { stroke-dashoffset: 0; }
  }
</style>
