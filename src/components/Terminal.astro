---
import { SITE, SOCIAL } from '../consts';
import {
  CURRENT_ROLES, PAST_ROLES, VOLUNTEERING, TECHNICAL_PROJECTS, TECH_SKILLS, EDUCATION,
} from '../data/content';

// Compact dataset handed to the client terminal as JSON.
const data = {
  name: SITE.name,
  email: SITE.email,
  about:
    "CS + Business at USC (Viterbi & Marshall), specializing in AI Applications. I build perception systems for robots, AI tools that ship, and web platforms used by thousands.",
  social: SOCIAL,
  resume: SOCIAL.resume,
  resumeFull: SOCIAL.resumeFull,
  skills: TECH_SKILLS,
  education: `${EDUCATION.degree} — ${EDUCATION.school}. ${EDUCATION.honors.join(' · ')}.`,
  experience: [...CURRENT_ROLES, ...PAST_ROLES].map((r) => ({
    role: r.role, org: r.org, date: r.date,
  })),
  volunteering: VOLUNTEERING.map((r) => ({ role: r.role, org: r.org, date: r.date })),
  projects: TECHNICAL_PROJECTS.map((p) => ({
    id: p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    name: p.name, blurb: p.blurb,
  })),
};
---

<div class="term" id="term" hidden>
  <div class="term-bar">
    <div class="term-dots">
      <button class="dot dot-red" data-close type="button" aria-label="Close terminal" title="Close"></button>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <span class="term-title">arsalan@portfolio: ~</span>
  </div>
  <div class="term-body" id="term-body" tabindex="0">
    <div id="term-out"></div>
    <div class="term-line">
      <span class="term-ps">arsalan@portfolio<b>:~$</b></span>
      <input id="term-in" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </div>
  </div>
</div>

<script type="application/json" id="term-data" set:html={JSON.stringify(data)} />

<style>
  .term {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(760px, 96vw);
    max-height: 60vh;
    z-index: 70;
    background: #14140f;
    border: 1px solid #2b2b22;
    border-bottom: none;
    box-shadow: 0 -16px 50px -16px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
  }
  .term[hidden] { display: none; }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #1d1d16;
    border-bottom: 1px solid #2b2b22;
  }
  .term-dots { display: flex; gap: 6px; align-items: center; }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .dot-yellow { background: #e8b84b; }
  .dot-green { background: #4caa5a; }
  .dot-red {
    background: #d9534f;
    cursor: pointer;
    font-size: 9px;
    line-height: 1;
    color: rgba(0, 0, 0, 0.6);
  }
  .dot-red::before { content: "✕"; opacity: 0; transition: opacity 0.12s ease; }
  .dot-red:hover { background: #e25c57; }
  .dot-red:hover::before,
  .dot-red:focus-visible::before { opacity: 1; }
  .term-title { color: #8a877c; font-size: 0.72rem; flex: 1; }
  .term-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #e7e5dd;
    outline: none;
  }
  .term-body :global(.t-accent) { color: #6b78ff; }
  .term-body :global(.t-dim) { color: #8a877c; }
  .term-body :global(.t-ok) { color: #4caa5a; }
  .term-body :global(a) { color: #6b78ff; }
  .term-body :global(.row) { white-space: pre-wrap; }
  .term-body :global(.t-cols) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 3px 22px;
    white-space: normal;
    margin: 4px 0;
  }
  .term-body :global(.t-cols) :global(span) { min-width: 0; }
  .term-body :global(.t-list) {
    display: flex;
    flex-direction: column;
    gap: 9px;
    white-space: normal;
    margin: 4px 0;
  }
  .term-body :global(.t-item) { display: flex; flex-direction: column; line-height: 1.5; }
  .term-body :global(.t-date) { font-size: 0.92em; opacity: 0.8; }
  .term-body :global(.t-block) {
    display: flex;
    flex-direction: column;
    gap: 5px;
    white-space: normal;
    margin: 2px 0;
  }
  .term-body :global(.t-block) :global(a) { word-break: break-word; }
  .term-line { display: flex; align-items: center; gap: 8px; }
  .term-ps { color: #4caa5a; white-space: nowrap; }
  .term-ps b { color: #8a877c; font-weight: 400; }
  #term-in {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #e7e5dd;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('term')!;
    const body = document.getElementById('term-body')!;
    const out = document.getElementById('term-out')!;
    const input = document.getElementById('term-in') as HTMLInputElement;
    const data = JSON.parse(document.getElementById('term-data')!.textContent || '{}');
    const history: string[] = [];
    let hi = -1;
    let booted = false;

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const print = (html: string, cls = 'row') => {
      const div = document.createElement('div');
      div.className = cls;
      div.innerHTML = html;
      out.appendChild(div);
      body.scrollTop = body.scrollHeight;
    };

    const commands: Record<string, (args: string[]) => void> = {
      help: () => {
        const rows: [string, string][] = [
          ['about', 'who I am'],
          ['experience', 'roles, current + past'],
          ['volunteering', 'suicide prevention + outreach'],
          ['ls', 'list projects'],
          ['cat &lt;id&gt;', 'read a project (e.g. cat robosub-perception)'],
          ['skills', 'tech stack'],
          ['education', 'school + honors'],
          ['contact', 'how to reach me'],
          ['social', 'links'],
          ['resume [full]', 'open résumé (1-page, or full 2-page)'],
          ['detect', 'toggle detection mode'],
          ['clear', 'clear the screen'],
        ];
        print(
          'Available commands:<div class="t-cols">' +
          rows.map(([c, d]) => `<span class="t-accent">${c}</span><span>${d}</span>`).join('') +
          '</div><span class="t-dim">try: sudo hire-me</span>'
        );
      },
      about: () => print(data.about),
      whoami: () => print(data.name),
      experience: () => print(
        '<div class="t-list">' +
        data.experience
          .map((e: any) => `<div class="t-item"><span class="t-accent">${esc(e.role)}</span><span class="t-dim">${esc(e.org)}</span><span class="t-dim t-date">${esc(e.date)}</span></div>`)
          .join('') +
        '</div>'
      ),
      volunteering: () => print(
        '<div class="t-list">' +
        data.volunteering
          .map((e: any) => `<div class="t-item"><span class="t-accent">${esc(e.role)}</span><span class="t-dim">${esc(e.org)}</span><span class="t-dim t-date">${esc(e.date)}</span></div>`)
          .join('') +
        '</div>'
      ),
      ls: () => print(
        '<div class="t-cols">' +
        data.projects.map((p: any) => `<span class="t-accent">${p.id}</span><span class="t-dim">${esc(p.name)}</span>`).join('') +
        '</div>'
      ),
      cat: (args) => {
        const id = (args[0] || '').toLowerCase();
        const p = data.projects.find((x: any) => x.id === id);
        if (!p) { print(`<span class="t-dim">cat: ${esc(id || '?')}: no such project. try </span><span class="t-accent">ls</span>`); return; }
        print(`<div class="t-block"><span class="t-accent">${esc(p.name)}</span><span>${esc(p.blurb)}</span></div>`);
      },
      skills: () => print(data.skills.join(' · ')),
      education: () => print(data.education),
      contact: () => print(`email: <a href="mailto:${data.email}">${data.email}</a>`),
      social: () => print(
        '<div class="t-block">' +
        [
          `<span><span class="t-dim">github</span> · <a href="${data.social.github}" target="_blank" rel="noopener">${data.social.github}</a></span>`,
          `<span><span class="t-dim">linkedin</span> · <a href="${data.social.linkedin}" target="_blank" rel="noopener">${data.social.linkedin}</a></span>`,
          `<span><span class="t-dim">instagram</span> · <a href="${data.social.instagram}" target="_blank" rel="noopener">${data.social.instagram}</a></span>`,
        ].join('') +
        '</div>'
      ),
      resume: (args) => {
        const full = args[0] === 'full';
        print(`<span class="t-dim">opening ${full ? 'full two-page' : 'one-page'} résumé… ${full ? '' : '(try <span class="t-accent">resume full</span> for the deep dive)'}</span>`);
        window.open(full ? data.resumeFull : data.resume, '_blank', 'noopener');
      },
      detect: () => { print('<span class="t-ok">detection mode toggled.</span>'); window.dispatchEvent(new CustomEvent('toggle-detection')); },
      clear: () => { out.innerHTML = ''; },
      sudo: (args) => {
        if (args.join(' ') === 'hire-me') {
          print('<div class="t-block"><span class="t-ok">[sudo] access granted.</span><span>Let’s talk → <a href="mailto:' + data.email + '">' + data.email + '</a></span></div>');
        } else {
          print('<span class="t-dim">usage: sudo hire-me</span>');
        }
      },
    };

    function exec(raw: string) {
      const line = raw.trim();
      print(`<span class="term-ps" style="color:#4caa5a">arsalan@portfolio<b style="color:#8a877c;font-weight:400">:~$</b></span> ${esc(line)}`);
      if (!line) return;
      history.unshift(line); hi = -1;
      const [cmd, ...args] = line.split(/\s+/);
      const fn = commands[cmd.toLowerCase()];
      if (fn) fn(args);
      else print(`<span class="t-dim">command not found: ${esc(cmd)}. type </span><span class="t-accent">help</span>`);
    }

    function boot() {
      if (booted) return;
      booted = true;
      print('<span class="t-dim">portfolio shell — type </span><span class="t-accent">help</span><span class="t-dim"> to start.</span>');
    }

    function open() {
      root.hidden = false;
      boot();
      requestAnimationFrame(() => input.focus());
    }
    function close() { root.hidden = true; }
    function toggle() { root.hidden ? open() : close(); }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { exec(input.value); input.value = ''; }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (hi < history.length - 1) input.value = history[++hi] || ''; }
      else if (e.key === 'ArrowDown') { e.preventDefault(); if (hi > 0) input.value = history[--hi] || ''; else { hi = -1; input.value = ''; } }
    });
    body.addEventListener('click', () => input.focus());
    root.querySelector('[data-close]')?.addEventListener('click', close);
    window.addEventListener('open-terminal', toggle);
    document.addEventListener('keydown', (e) => {
      // backtick toggles terminal when not typing in a field
      const t = e.target as HTMLElement;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA');
      if (e.key === '`' && !typing) { e.preventDefault(); toggle(); }
      if (e.key === 'Escape' && !root.hidden) close();
    });
  })();
</script>
