---
import { SITE, SOCIAL } from '../consts';
import run from '../data/gtsam-run.json';
import {
  CURRENT_ROLES, PAST_ROLES, VOLUNTEERING, TECHNICAL_PROJECTS, TECH_SKILLS, EDUCATION,
} from '../data/content';

// Compact dataset handed to the client terminal as JSON.
const data = {
  name: SITE.name,
  email: SITE.email,
  about:
    "CS + Business at USC (Viterbi & Marshall), specializing in AI Applications. I build perception systems for robots, AI tools that ship, and web platforms used by thousands.",
  social: SOCIAL,
  resume: SOCIAL.resume,
  skills: TECH_SKILLS,
  education: `${EDUCATION.degree} — ${EDUCATION.school}. ${EDUCATION.honors.join(' · ')}.`,
  experience: [...CURRENT_ROLES, ...PAST_ROLES].map((r) => ({
    role: r.role, org: r.org, date: r.date, summary: r.summary,
  })),
  volunteering: VOLUNTEERING.map((r) => ({ role: r.role, org: r.org, date: r.date, summary: r.summary })),
  replay: (() => {
    // mission log + a visual event per line, generated from the real GTSAM export
    const first: Record<number, number> = {};
    for (const [pi, lid] of run.edges as [number, number][]) if (!(lid in first)) first[lid] = pi;
    const lines: { text: string; ev: Record<string, unknown> }[] = [];
    run.poses.forEach(([x, y, yaw], i) => {
      lines.push({ text: `t=${(i * 0.5).toFixed(1).padStart(5)}s  pose  x=${x.toFixed(2)}  y=${y.toFixed(2)}  ψ=${String(Math.round((yaw * 180) / Math.PI)).padStart(4)}°`, ev: { k: 'pose', i } });
      for (const l of run.landmarks) if (first[l.id] === i) lines.push({ text: `t=${(i * 0.5).toFixed(1).padStart(5)}s  ★ new landmark L${l.id} (${l.label})  seeded at (${l.seed[0].toFixed(2)}, ${l.seed[1].toFixed(2)})`, ev: { k: 'lm', id: l.id } });
    });
    lines.push({ text: '── optimize (GTSAM, Levenberg–Marquardt) ──', ev: { k: 'sep' } });
    run.frames.forEach((f) => lines.push({ text: `iter ${f.iter}  graph error ${f.cost.toFixed(3).padStart(8)}  worst landmark ±${Math.max(...Object.values(f.error as Record<string, number>)).toFixed(2)} m`, ev: { k: 'iter', n: f.iter } }));
    lines.push({ text: `✓ ${run.landmarks.length} landmarks under 0.30 m · ${run.edges.length} factors · ${run.poses.length} poses`, ev: { k: 'done' } });
    return { lines, run: { poses: run.poses, landmarks: run.landmarks, truth: run.truth, frames: run.frames.map((f) => f.landmarks), edges: run.edges } };
  })(),
  projects: TECHNICAL_PROJECTS.map((p) => ({
    id: p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    name: p.name, blurb: p.blurb,
  })),
};
---

<div class="term-bubble" id="term-bubble" hidden role="img" aria-label="Map of the SLAM replay: trajectory, landmark sightings, and optimizer convergence">
  <div class="tb-head"><span>slam replay</span><span id="tb-stat"></span><button class="tb-x" type="button" aria-label="Close replay map">×</button></div>
  <canvas id="tb-canvas" width="680" height="440"></canvas>
</div>
<div class="term" id="term" hidden>
  <div class="term-bar">
    <div class="term-dots">
      <button class="dot dot-red" data-close type="button" aria-label="Close terminal" title="Close"></button>
      <button class="dot dot-yellow" data-min type="button" aria-label="Minimize terminal" title="Minimize"></button>
      <button class="dot dot-green" data-max type="button" aria-label="Maximize terminal" title="Maximize"></button>
    </div>
    <span class="term-title">arsalan@portfolio: ~</span>
  </div>
  <div class="term-body" id="term-body" tabindex="0">
    <div id="term-out"></div>
    <div class="term-line">
      <span class="term-ps">arsalan@portfolio<b>:~$</b></span>
      <input id="term-in" type="text" aria-label="Terminal command input" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </div>
  </div>
</div>

<script type="application/json" id="term-data" set:html={JSON.stringify(data)} />

<style>
  .term {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(760px, 96vw);
    max-height: 60vh;
    z-index: 70;
    background: #14140f;
    border: 1px solid #2b2b22;
    border-bottom: none;
    box-shadow: 0 -16px 50px -16px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
  }
  .term[hidden] { display: none; }
  .term-bubble {
    position: fixed; z-index: 71; width: 340px;
    background: #14140f; border: 1px solid #2b2b22; box-shadow: 0 16px 50px -16px rgba(0, 0, 0, 0.6);
    font-family: var(--font-mono);
  }
  .term-bubble[hidden] { display: none; }
  .term-bubble::after { content: ""; position: absolute; left: 28px; bottom: -8px; width: 14px; height: 14px; background: #14140f; border-right: 1px solid #2b2b22; border-bottom: 1px solid #2b2b22; transform: rotate(45deg); }
  .tb-head { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-bottom: 1px solid #2b2b22; font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: #8a877c; }
  .tb-head span:first-child { color: #e7e5dd; }
  .tb-x { margin-left: auto; background: none; border: 0; color: #8a877c; font-size: 1rem; line-height: 1; cursor: pointer; }
  .tb-x:hover { color: #e7e5dd; }
  #tb-canvas { display: block; width: 100%; height: auto; }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #1d1d16;
    border-bottom: 1px solid #2b2b22;
  }
  .term-dots { display: flex; gap: 6px; align-items: center; }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .dot-red, .dot-yellow, .dot-green {
    cursor: pointer;
    font-size: 9px;
    line-height: 1;
    color: rgba(0, 0, 0, 0.6);
  }
  .dot::before { opacity: 0; transition: opacity 0.12s ease; }
  .dot:hover::before,
  .dot:focus-visible::before { opacity: 1; }
  .dot-red { background: #d9534f; }
  .dot-red::before { content: "✕"; }
  .dot-red:hover { background: #e25c57; }
  .dot-yellow { background: #e8b84b; }
  .dot-yellow::before { content: "−"; }
  .dot-yellow:hover { background: #f0c65e; }
  .dot-green { background: #4caa5a; }
  .dot-green::before { content: "+"; }
  .dot-green:hover { background: #5cbb6a; }

  .term.min .term-body { display: none; }
  .term.max { width: min(1100px, 98vw); height: 88vh; max-height: 88vh; }
  .term-title { color: #8a877c; font-size: 0.72rem; flex: 1; }
  .term-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #e7e5dd;
    outline: none;
  }
  .term-body :global(.t-accent) { color: #6b78ff; }
  .term-body :global(.t-dim) { color: #8a877c; }
  .term-body :global(.t-ok) { color: #4caa5a; }
  .term-body :global(a) { color: #6b78ff; }
  .term-body :global(.t-row) { white-space: pre-wrap; }
  .term-body :global(.t-cols) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 3px 22px;
    white-space: normal;
    margin: 4px 0;
  }
  .term-body :global(.t-cols) :global(span) { min-width: 0; }
  .term-body :global(.t-list) {
    display: flex;
    flex-direction: column;
    gap: 9px;
    white-space: normal;
    margin: 4px 0;
  }
  .term-body :global(.t-item) { display: flex; flex-direction: column; line-height: 1.5; }
  .term-body :global(.t-role-line) { display: flex; justify-content: space-between; gap: 6px 16px; flex-wrap: wrap; }
  .term-body :global(.t-date) { font-size: 0.92em; }
  .term-body :global(.t-block) {
    display: flex;
    flex-direction: column;
    gap: 5px;
    white-space: normal;
    margin: 2px 0;
  }
  .term-body :global(.t-block) :global(a) { word-break: break-word; }
  .term-body :global(.t-cols) :global(a) { word-break: break-word; }
  .term-body :global(.t-echo) { display: flex; gap: 8px; white-space: normal; }
  .term-body :global(.t-ps) { color: #4caa5a; white-space: nowrap; }
  .term-body :global(.t-ps b) { color: #8a877c; font-weight: 400; }
  .term-line { display: flex; align-items: center; gap: 8px; }
  .term-ps { color: #4caa5a; white-space: nowrap; }
  .term-ps b { color: #8a877c; font-weight: 400; }
  #term-in {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #e7e5dd;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('term')!;
    const body = document.getElementById('term-body')!;
    const out = document.getElementById('term-out')!;
    const input = document.getElementById('term-in') as HTMLInputElement;
    const data = JSON.parse(document.getElementById('term-data')!.textContent || '{}');
    const history: string[] = [];
    let hi = -1;
    let booted = false;
    let replaying = false;

    // ---- replay map (the "bubble"): a top-down view that follows the log
    const bub = document.getElementById('term-bubble')!, bstat = document.getElementById('tb-stat')!;
    const bcv = document.getElementById('tb-canvas') as HTMLCanvasElement, bctx = bcv.getContext('2d')!;
    const R = data.replay.run;
    const SX = (x: number) => 40 + x * 46, SY = (y: number) => 410 - y * 30; // 12 m × 12 m → 680 × 440
    const st = { poses: 0, lms: new Set<number>(), iter: -1, done: false };
    function placeBubble() {
      const r = root.getBoundingClientRect();
      bub.style.left = `${Math.max(8, r.left)}px`;
      bub.style.bottom = `${Math.min(window.innerHeight - 8, window.innerHeight - r.top) + 14}px`;
    }
    function drawBubble() {
      placeBubble(); // the terminal grows as lines print; keep the bubble above it
      const c = bctx; c.clearRect(0, 0, bcv.width, bcv.height);
      c.font = '13px JetBrains Mono, monospace';
      c.strokeStyle = '#2b2b22'; c.lineWidth = 1;
      for (let g = 0; g <= 12; g += 2) { c.beginPath(); c.moveTo(SX(g), SY(0)); c.lineTo(SX(g), SY(12)); c.stroke(); c.beginPath(); c.moveTo(SX(0), SY(g)); c.lineTo(SX(12), SY(g)); c.stroke(); }
      // truth + 0.3 m spec circles
      for (const t of R.truth) { const [x, y] = t.xy; c.strokeStyle = 'rgba(231,229,221,0.35)'; c.setLineDash([3, 4]); c.beginPath(); c.ellipse(SX(x), SY(y), 0.3 * 46, 0.3 * 30, 0, 0, Math.PI * 2); c.stroke(); c.setLineDash([]); c.beginPath(); c.moveTo(SX(x) - 4, SY(y)); c.lineTo(SX(x) + 4, SY(y)); c.moveTo(SX(x), SY(y) - 4); c.lineTo(SX(x), SY(y) + 4); c.stroke(); }
      // trajectory so far
      c.strokeStyle = '#4caa5a'; c.lineWidth = 1.5; c.setLineDash([4, 4]); c.beginPath();
      for (let i = 0; i < st.poses; i++) { const [x, y] = R.poses[i]; i ? c.lineTo(SX(x), SY(y)) : c.moveTo(SX(x), SY(y)); }
      c.stroke(); c.setLineDash([]);
      // landmarks at seed (iter -1) or at the current iteration's estimate; factors from recent poses
      const frame = st.iter >= 0 ? R.frames[Math.min(st.iter, R.frames.length - 1)] : null;
      for (const l of R.landmarks) {
        if (!st.lms.has(l.id)) continue;
        const [x, y] = frame ? frame[String(l.id)] : l.seed;
        c.strokeStyle = 'rgba(255,138,85,0.45)'; c.lineWidth = 1;
        for (const [pi, lid] of R.edges) if (lid === l.id && pi < st.poses && pi >= st.poses - 8) { c.beginPath(); c.moveTo(SX(R.poses[pi][0]), SY(R.poses[pi][1])); c.lineTo(SX(x), SY(y)); c.stroke(); }
        const t = R.truth[l.truth].xy, err = Math.hypot(x - t[0], y - t[1]);
        c.fillStyle = st.done || (frame && err < 0.3) ? '#4caa5a' : '#ff8a55'; c.beginPath(); c.arc(SX(x), SY(y), 5, 0, Math.PI * 2); c.fill();
        c.fillStyle = '#e7e5dd'; c.fillText(`${l.label.replace('_', ' ')} ±${err.toFixed(2)}`, SX(x) + 9, SY(y) + 4);
      }
      // current pose
      if (st.poses) { const [x, y, yaw] = R.poses[st.poses - 1]; c.fillStyle = '#e7e5dd'; c.save(); c.translate(SX(x), SY(y)); c.rotate(-yaw); c.beginPath(); c.moveTo(10, 0); c.lineTo(-6, 5); c.lineTo(-6, -5); c.closePath(); c.fill(); c.restore(); }
      bstat.textContent = st.done ? 'converged ✓' : st.iter >= 0 ? `optimizing · iter ${st.iter}` : `pose ${st.poses}/${R.poses.length} · ${st.lms.size} landmarks`;
    }
    function applyEvent(ev: any) {
      if (ev.k === 'pose') st.poses = ev.i + 1;
      else if (ev.k === 'lm') st.lms.add(ev.id);
      else if (ev.k === 'iter') st.iter = ev.n;
      else if (ev.k === 'done') st.done = true;
      drawBubble();
    }
    function openBubble() { st.poses = 0; st.lms.clear(); st.iter = -1; st.done = false; bub.hidden = false; placeBubble(); drawBubble(); }
    function closeBubble() { bub.hidden = true; }
    bub.querySelector('.tb-x')!.addEventListener('click', closeBubble);
    window.addEventListener('resize', () => { if (!bub.hidden) placeBubble(); });

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const print = (html: string, cls = 't-row') => {
      const div = document.createElement('div');
      div.className = cls;
      div.innerHTML = html;
      out.appendChild(div);
      body.scrollTop = body.scrollHeight;
    };

    const commands: Record<string, (args: string[]) => void> = {
      help: () => {
        const rows: [string, string][] = [
          ['about', 'who I am'],
          ['experience', 'roles, current + past'],
          ['volunteering', 'suicide prevention + outreach'],
          ['ls', 'list projects'],
          ['cat &lt;id&gt;', 'read a project (e.g. cat ask-usg)'],
          ['skills', 'tech stack'],
          ['education', 'school + honors'],
          ['contact', 'how to reach me'],
          ['social', 'links'],
          ['resume', 'open résumé'],
          ['replay', 'replay a SLAM run (real GTSAM output)'],
          ['detect', 'toggle detection mode'],
          ['clear', 'clear the screen'],
        ];
        print(
          'Available commands:<div class="t-cols">' +
          rows.map(([c, d]) => `<span class="t-accent">${c}</span><span>${d}</span>`).join('') +
          '</div><span class="t-dim">try: sudo hire-me</span>'
        );
      },
      about: () => print(data.about),
      whoami: () => print(data.name),
      experience: () => print(
        '<div class="t-list">' +
        data.experience
          .map((e: any) => `<div class="t-item"><span class="t-role-line"><span class="t-accent">${esc(e.role)}</span>${e.summary ? `<span class="t-dim">${esc(e.summary)}</span>` : ''}</span><span class="t-dim">${esc(e.org)}</span><span class="t-dim t-date">${esc(e.date)}</span></div>`)
          .join('') +
        '</div>'
      ),
      volunteering: () => print(
        '<div class="t-list">' +
        data.volunteering
          .map((e: any) => `<div class="t-item"><span class="t-role-line"><span class="t-accent">${esc(e.role)}</span>${e.summary ? `<span class="t-dim">${esc(e.summary)}</span>` : ''}</span><span class="t-dim">${esc(e.org)}</span><span class="t-dim t-date">${esc(e.date)}</span></div>`)
          .join('') +
        '</div>'
      ),
      ls: () => print(
        '<div class="t-cols">' +
        data.projects.map((p: any) => `<span class="t-accent">${p.id}</span><span class="t-dim">${esc(p.name)}</span>`).join('') +
        '</div>'
      ),
      cat: (args) => {
        const id = (args[0] || '').toLowerCase();
        const p = data.projects.find((x: any) => x.id === id);
        if (!p) { print(`<span class="t-dim">cat: ${esc(id || '?')}: no such project. try </span><span class="t-accent">ls</span>`); return; }
        print(`<div class="t-block"><span class="t-accent">${esc(p.name)}</span><span>${esc(p.blurb)}</span></div>`);
      },
      skills: () => print(data.skills.join(' · ')),
      education: () => print(data.education),
      contact: () => print(`email: <a href="mailto:${data.email}">${data.email}</a>`),
      social: () => print(
        '<div class="t-cols">' +
        ['github', 'linkedin', 'instagram']
          .map((k) => `<span class="t-dim">${k}</span><a href="${data.social[k]}" target="_blank" rel="noopener">${data.social[k]}</a>`)
          .join('') +
        '</div>'
      ),
      resume: () => {
        print('<span class="t-dim">opening résumé…</span>');
        window.open(data.resume, '_blank', 'noopener');
      },
      replay: () => {
        if (replaying) { print('<span class="t-dim">already replaying…</span>'); return; }
        replaying = true;
        openBubble();
        const L = data.replay.lines as { text: string; ev: any }[];
        print('<span class="t-dim">replaying mission log · ' + L.length + ' lines · source: scripts/export-gtsam-run.py · map above ↑</span>');
        L.forEach(({ text, ev }, i) => setTimeout(() => {
          const cls = ev.k === 'done' ? 't-ok' : ev.k === 'lm' || ev.k === 'iter' ? 't-accent' : ev.k === 'sep' ? 't-dim' : '';
          print(`<span class="${cls}">${esc(text)}</span>`);
          applyEvent(ev);
          if (i === L.length - 1) replaying = false;
        }, ev.k === 'iter' || ev.k === 'done' ? 70 * i + 500 : 70 * i));
      },
      detect: () => { print('<span class="t-ok">detection mode toggled.</span>'); window.dispatchEvent(new CustomEvent('toggle-detection')); },
      clear: () => { out.innerHTML = ''; },
      sudo: (args) => {
        if (args.join(' ') === 'hire-me') {
          print('<div class="t-block"><span class="t-ok">[sudo] access granted.</span><span>Let’s talk → <a href="mailto:' + data.email + '">' + data.email + '</a></span></div>');
        } else {
          print('<span class="t-dim">usage: sudo hire-me</span>');
        }
      },
    };

    function exec(raw: string) {
      const line = raw.trim();
      print(`<div class="t-echo"><span class="t-ps">arsalan@portfolio<b>:~$</b></span><span>${esc(line)}</span></div>`);
      if (!line) return;
      history.unshift(line); hi = -1;
      const [cmd, ...args] = line.split(/\s+/);
      const fn = commands[cmd.toLowerCase()];
      if (fn) fn(args);
      else print(`<span class="t-dim">command not found: ${esc(cmd)}. type </span><span class="t-accent">help</span>`);
    }

    function boot() {
      if (booted) return;
      booted = true;
      print('<span class="t-dim">portfolio shell — type </span><span class="t-accent">help</span><span class="t-dim"> to start.</span>');
    }

    function open() {
      root.hidden = false;
      boot();
      requestAnimationFrame(() => input.focus());
    }
    function close() { root.hidden = true; closeBubble(); }
    function toggle() { root.hidden ? open() : close(); }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { exec(input.value); input.value = ''; }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (hi < history.length - 1) input.value = history[++hi] || ''; }
      else if (e.key === 'ArrowDown') { e.preventDefault(); if (hi > 0) input.value = history[--hi] || ''; else { hi = -1; input.value = ''; } }
    });
    body.addEventListener('click', () => input.focus());
    root.querySelector('[data-close]')?.addEventListener('click', close);
    root.querySelector('[data-min]')?.addEventListener('click', () => {
      root.classList.remove('max');
      root.classList.toggle('min');
      if (!bub.hidden) requestAnimationFrame(placeBubble);
    });
    root.querySelector('[data-max]')?.addEventListener('click', () => {
      root.classList.remove('min');
      root.classList.toggle('max');
      if (!bub.hidden) requestAnimationFrame(placeBubble);
      input.focus();
    });
    window.addEventListener('open-terminal', toggle);
    document.addEventListener('keydown', (e) => {
      // backtick toggles terminal when not typing in a field
      const t = e.target as HTMLElement;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA');
      if (e.key === '`' && !typing) { e.preventDefault(); toggle(); }
      if (e.key === 'Escape' && !root.hidden) close();
    });
  })();
</script>
