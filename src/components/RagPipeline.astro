---
// Ask USG retrieval pipeline, drawn in SVG and animated with pure CSS.
// A query splits into BM25 + pgvector lanes, fuses (RRF), pulls sibling
// chunks, and streams the answer. Loops while on screen; motion-path dots.
const LANE = { bm25: 'M92,100 C120,100 120,50 150,50 L220,50', vec: 'M92,100 C120,100 120,150 150,150 L220,150' };
const MERGE = { bm25: 'M220,50 C240,50 240,100 262,100', vec: 'M220,150 C240,150 240,100 262,100' };
---

<svg class="rag" viewBox="0 0 520 200" role="img" aria-label="Animated diagram of the Ask USG retrieval pipeline: a question is searched by BM25 and pgvector in parallel, the results are fused, sibling chunks are expanded, and the answer streams out." xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="rag-arr" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="5" markerHeight="5" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="var(--line)"/></marker>
  </defs>

  <!-- wires -->
  <g class="wires" fill="none" stroke="var(--line)" stroke-width="1.2">
    <path d={LANE.bm25} /><path d={LANE.vec} />
    <path d={MERGE.bm25} /><path d={MERGE.vec} />
    <path d="M332,100 L352,100" marker-end="url(#rag-arr)" />
    <path d="M422,100 L442,100" marker-end="url(#rag-arr)" />
  </g>

  <!-- stages -->
  <g class="stage s-query"><rect x="12" y="82" width="80" height="36" /><text x="52" y="104">query</text></g>
  <g class="stage s-bm25"><rect x="150" y="32" width="70" height="36" /><text x="185" y="54">BM25</text></g>
  <g class="stage s-vec"><rect x="150" y="132" width="70" height="36" /><text x="185" y="154">pgvector</text></g>
  <g class="stage s-fuse"><rect x="262" y="82" width="70" height="36" /><text x="297" y="104">RRF fuse</text></g>
  <g class="stage s-sib"><rect x="352" y="82" width="70" height="36" /><text x="387" y="104">+siblings</text></g>
  <g class="stage s-llm"><rect x="442" y="82" width="66" height="36" /><text x="475" y="104">answer</text></g>

  <!-- travelling tokens -->
  <circle class="dot d1" r="3.5" style={`offset-path: path('${LANE.bm25}')`} />
  <circle class="dot d2" r="3.5" style={`offset-path: path('${LANE.vec}')`} />
  <circle class="dot d3" r="3.5" style={`offset-path: path('${MERGE.bm25}')`} />
  <circle class="dot d4" r="3.5" style={`offset-path: path('${MERGE.vec}')`} />
  <circle class="dot d5" r="3.5" style="offset-path: path('M332,100 L352,100')" />
  <circle class="dot d6" r="3.5" style="offset-path: path('M422,100 L442,100')" />

  <!-- streamed answer tokens -->
  <g class="tokens" fill="var(--accent)">
    {Array.from({ length: 9 }).map((_, i) => <rect x={446 + (i % 5) * 12} y={128 + Math.floor(i / 5) * 8} width={i === 8 ? 6 : 9} height="4" style={`animation-delay: ${4.1 + i * 0.12}s`} />)}
  </g>

  <!-- readouts -->
  <g class="meter">
    <text class="m m1" x="12" y="24">MRR  0.91 → 0.98</text>
    <text class="m m2" x="12" y="40">TTFT  6.2 s → 0.5 s</text>
    <text class="m m3" x="12" y="184">answer quality  83% → 95%  ·  1,100 beta questions</text>
    <text class="m m4" x="508" y="184" text-anchor="end">illustrative</text>
  </g>
</svg>

<style>
  .rag { display: block; width: 100%; height: auto; margin: 6px 0 2px; border: 1px solid var(--line); background: var(--paper); }
  .stage rect { fill: var(--panel); stroke: var(--line); stroke-width: 1; transition: stroke 0.2s; }
  .stage text { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-soft); text-anchor: middle; }
  .dot { fill: var(--accent); opacity: 0; }
  .tokens rect { opacity: 0; }
  .meter .m { font-family: var(--font-mono); font-size: 9px; fill: var(--ink-faint); letter-spacing: 0.04em; }
  .meter .m1, .meter .m2 { opacity: 0; }

  /* Everything runs on one 6.5 s clock; delays place each piece on it. */
  .rag :is(.dot, .stage rect, .tokens rect, .m1, .m2) { animation-duration: 6.5s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; animation-play-state: paused; }
  :global(.in) .rag :is(.dot, .stage rect, .tokens rect, .m1, .m2) { animation-play-state: running; }

  .d1, .d2 { animation-name: travel; animation-delay: 0.6s; }
  .d2 { animation-delay: 0.9s; }
  .d3, .d4 { animation-name: travel; animation-delay: 2.0s; }
  .d4 { animation-delay: 2.25s; }
  .d5 { animation-name: travel; animation-delay: 3.1s; }
  .d6 { animation-name: travel; animation-delay: 3.8s; }
  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    2% { opacity: 1; }
    16% { offset-distance: 100%; opacity: 1; }
    18%, 100% { offset-distance: 100%; opacity: 0; }
  }

  .s-query rect { animation-name: lit; animation-delay: 0.2s; }
  .s-bm25 rect  { animation-name: lit; animation-delay: 1.5s; }
  .s-vec rect   { animation-name: lit; animation-delay: 1.9s; }
  .s-fuse rect  { animation-name: lit; animation-delay: 2.9s; }
  .s-sib rect   { animation-name: lit; animation-delay: 3.6s; }
  .s-llm rect   { animation-name: lit; animation-delay: 4.2s; }
  @keyframes lit {
    0%, 100% { stroke: var(--line); }
    3%, 14% { stroke: var(--accent); }
    20% { stroke: var(--line); }
  }

  .tokens rect { animation-name: tok; }
  @keyframes tok { 0% { opacity: 0; } 4%, 90% { opacity: 1; } 96%, 100% { opacity: 0; } }

  .m1 { animation-name: fade; animation-delay: 2.9s; }
  .m2 { animation-name: fade; animation-delay: 4.3s; }
  @keyframes fade { 0% { opacity: 0; } 5%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .rag :is(.dot, .stage rect, .tokens rect, .m1, .m2) { animation: none; }
    .tokens rect, .m1, .m2 { opacity: 1; }
  }
</style>
