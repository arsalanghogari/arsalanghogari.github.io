---
// Live YOLO inference in the browser: the team's actual detector (best.pt,
// exported to ONNX and int8-quantized, 9.4 MB) runs on real GoPro pool frames
// via onnxruntime-web. Opt-in: nothing downloads until the button is pressed.
const FRAMES = 9;
const NAMES = ['divider', 'gate', 'path', 'red_pipe', 'search_rescue', 'survey_repair', 'white_pipe'];
---

<figure class="ld" id="ld" data-names={JSON.stringify(NAMES)} data-frames={FRAMES}>
  <div class="ld-stage">
    <img class="ld-img" src="/images/detect/01.jpg" width="640" height="640" alt="Underwater pool frame from the AUV's camera" loading="lazy" />
    <canvas class="ld-canvas" width="640" height="640" aria-hidden="true"></canvas>
    <span class="ld-tag"><span class="ld-dot"></span>real frames · robosub course</span>
    <span class="ld-hud" id="ld-hud">yolo · onnx int8 · onnxruntime-web</span>
    <button class="ld-run" id="ld-run" type="button">run the detector in your browser</button>
  </div>
  <figcaption class="ld-cap"><span id="ld-status">the AUV's own YOLO weights, running on your CPU</span><span class="ld-frame" id="ld-frame"></span></figcaption>
</figure>

<style>
  .ld { margin: 6px 0 2px; border: 1px solid var(--line); background: var(--paper); }
  .ld-stage { position: relative; aspect-ratio: 2.6 / 1; overflow: hidden; background: #0b2a33; }
  .ld-img, .ld-canvas { position: absolute; left: 50%; top: 50%; width: auto; height: 100%; transform: translate(-50%, -50%); }
  .ld-img { object-fit: cover; }
  .ld-tag, .ld-hud { position: absolute; font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; opacity: 0.85; text-shadow: 0 1px 2px rgba(0,0,0,0.6); }
  .ld-tag { top: 8px; left: 10px; display: inline-flex; align-items: center; gap: 6px; }
  .ld-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--good-dot); }
  .ld-hud { right: 10px; bottom: 8px; }
  .ld-run {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    font-family: var(--font-mono); font-size: 0.74rem; padding: 10px 14px; cursor: pointer;
    background: var(--accent); color: #fff; border: 1px solid var(--accent);
    transition: transform 0.18s var(--ease), background 0.18s;
  }
  .ld-run:hover { transform: translate(-50%, -50%) translateY(-2px); background: var(--accent-deep); }
  .ld.live .ld-run { display: none; }
  .ld-cap { display: flex; justify-content: space-between; gap: 12px; padding: 8px 10px; font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-faint); }
  .ld.live .ld-cap { color: var(--ink-soft); }
</style>

<script>
  (() => {
    const root = document.getElementById('ld')!;
    const img = root.querySelector<HTMLImageElement>('.ld-img')!;
    const cv = root.querySelector<HTMLCanvasElement>('.ld-canvas')!;
    const ctx = cv.getContext('2d')!;
    const status = document.getElementById('ld-status')!, frameEl = document.getElementById('ld-frame')!, hud = document.getElementById('ld-hud')!;
    const names: string[] = JSON.parse(root.dataset.names!);
    const N = Number(root.dataset.frames);
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    const SZ = 416, CONF = 0.4, IOU = 0.5;

    document.getElementById('ld-run')!.addEventListener('click', async (e) => {
      e.preventDefault(); e.stopPropagation();
      root.classList.add('live');
      try {
        status.textContent = 'loading runtime…';
        const ort = await import('onnxruntime-web/wasm');
        // dev server can't serve module files out of public/; the build can
        ort.env.wasm.wasmPaths = import.meta.env.DEV ? '/node_modules/onnxruntime-web/dist/' : '/ort/';
        ort.env.wasm.numThreads = 1;
        status.textContent = 'loading model (9.4 MB)…';
        const session = await ort.InferenceSession.create('/models/barracuda-yolo-int8.onnx', { executionProviders: ['wasm'] });
        const pre = document.createElement('canvas'); pre.width = SZ; pre.height = SZ;
        const pctx = pre.getContext('2d', { willReadFrequently: true })!;
        const input = new Float32Array(3 * SZ * SZ);
        let i = 0, stop = false;
        new IntersectionObserver(([en]) => { stop = !en.isIntersecting; }).observe(root);

        async function detect(im: HTMLImageElement) {
          pctx.drawImage(im, 0, 0, SZ, SZ);
          const d = pctx.getImageData(0, 0, SZ, SZ).data;
          for (let p = 0, q = 0; p < d.length; p += 4, q++) { input[q] = d[p] / 255; input[SZ * SZ + q] = d[p + 1] / 255; input[2 * SZ * SZ + q] = d[p + 2] / 255; }
          const t0 = performance.now();
          const out = await session.run({ images: new ort.Tensor('float32', input, [1, 3, SZ, SZ]) });
          const ms = performance.now() - t0;
          const y = out.output0.data as Float32Array, [, C, A] = out.output0.dims as number[];
          // decode [4+nc, anchors] → boxes, then greedy NMS
          const cands: { x: number; y: number; w: number; h: number; c: number; s: number }[] = [];
          for (let a = 0; a < A; a++) {
            let best = 0, bc = 0;
            for (let c = 4; c < C; c++) { const s = y[c * A + a]; if (s > best) { best = s; bc = c - 4; } }
            if (best < CONF) continue;
            cands.push({ x: y[a], y: y[A + a], w: y[2 * A + a], h: y[3 * A + a], c: bc, s: best });
          }
          cands.sort((p, q) => q.s - p.s);
          const keep: typeof cands = [];
          for (const b of cands) {
            if (keep.some((k) => k.c === b.c && iou(k, b) > IOU)) continue;
            keep.push(b);
          }
          return { keep, ms };
        }
        const iou = (a: any, b: any) => {
          const ix = Math.max(0, Math.min(a.x + a.w / 2, b.x + b.w / 2) - Math.max(a.x - a.w / 2, b.x - b.w / 2));
          const iy = Math.max(0, Math.min(a.y + a.h / 2, b.y + b.h / 2) - Math.max(a.y - a.h / 2, b.y - b.h / 2));
          const inter = ix * iy; return inter / (a.w * a.h + b.w * b.h - inter);
        };
        function draw(boxes: { x: number; y: number; w: number; h: number; c: number; s: number }[]) {
          const k = cv.width / SZ;
          ctx.clearRect(0, 0, cv.width, cv.height);
          ctx.font = '13px JetBrains Mono, monospace';
          for (const b of boxes) {
            const x0 = (b.x - b.w / 2) * k, y0 = (b.y - b.h / 2) * k, w = b.w * k, h = b.h * k;
            ctx.strokeStyle = accent; ctx.lineWidth = 2; ctx.strokeRect(x0, y0, w, h);
            const L = 12; ctx.lineWidth = 4;
            for (const [cx, cy, sx, sy] of [[x0, y0, 1, 1], [x0 + w, y0, -1, 1], [x0, y0 + h, 1, -1], [x0 + w, y0 + h, -1, -1]]) {
              ctx.beginPath(); ctx.moveTo(cx, cy + sy * L); ctx.lineTo(cx, cy); ctx.lineTo(cx + sx * L, cy); ctx.stroke();
            }
            const label = `${names[b.c]} ${b.s.toFixed(2)}`, tw = ctx.measureText(label).width + 10;
            ctx.fillStyle = accent; ctx.fillRect(x0, y0 - 18, tw, 18);
            ctx.fillStyle = '#fff'; ctx.fillText(label, x0 + 5, y0 - 5);
          }
        }
        async function next() {
          const src = `/images/detect/${String(i + 1).padStart(2, '0')}.jpg`;
          const im = new Image(); im.src = src; await im.decode();
          img.src = src;
          const { keep, ms } = await detect(im);
          draw(keep);
          status.textContent = `${keep.length} detection${keep.length === 1 ? '' : 's'} · ${ms.toFixed(0)} ms inference`;
          frameEl.textContent = `frame ${i + 1}/${N}`;
          hud.textContent = `yolo · onnx int8 · wasm · ${ms.toFixed(0)} ms`;
          i = (i + 1) % N;
          setTimeout(() => (stop ? waitVisible() : next()), 900);
        }
        function waitVisible() { const t = setInterval(() => { if (!stop) { clearInterval(t); next(); } }, 300); }
        next();
      } catch (err) {
        status.textContent = 'detector failed to load in this browser';
        console.error(err);
      }
    });
  })();
</script>
